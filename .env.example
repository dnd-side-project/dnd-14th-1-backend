# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dnd_14
DB_USER=root
DB_PASSWORD=1234

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
JWT_EXPIRATION_TIME=3600000

# Apple OAuth Configuration
APPLE_CLIENT_ID=com.example.app
APPLE_TEAM_ID=ABCD123456

SERVER_PORT=8080

# Swagger Configuration
# Swagger UI에서 API 요청을 보낼 서버 URL
SWAGGER_SERVER_URL=http://localhost:8080

# CORS Configuration
# Comma-separated list of allowed origins for CORS
# Examples: http://localhost:3000,https://localhost.com,https://example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost.com

# Nginx Configuration
NGINX_SERVER_NAME=your-domain-or-ip
CERTBOT_EMAIL=your-email@example.com

